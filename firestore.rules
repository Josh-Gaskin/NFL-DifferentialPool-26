rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two Google accounts may read or write picks.
    // Must match ALLOWED_EMAILS in js/firebase-config.js.
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          "you@gmail.com",
          "partner@gmail.com"
        ];
    }

    match /picks/{seasonYear} {
      allow read, write: if isAllowed();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
